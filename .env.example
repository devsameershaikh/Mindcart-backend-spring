# Copy to .env (or set these as real environment variables / secrets in your
# deployment platform) -- never commit a filled-in .env file.

# --- Server ---
PORT=4000
SOCKETIO_PORT=4001

# --- Database (Postgres / Neon) ---
# Use the POOLED connection string here.
DATABASE_URL=jdbc:postgresql://HOST:5432/DBNAME
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
# 'always' runs schema.sql on every boot (safe: IF NOT EXISTS everywhere).
# Switch to 'never' once the DB is provisioned and you manage schema changes yourself.
SQL_INIT_MODE=always

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_DAYS=30

# Comma-separated OAuth client ids issued to your app (one per platform: iOS/Android/Web)
GOOGLE_CLIENT_IDS=

# --- CORS ---
# Comma-separated list of allowed browser origins. Leave empty to block all
# browser-based origins (native/mobile clients are unaffected by CORS).
CORS_ALLOWED_ORIGINS=

# --- Rate limiting (see application.yml for the underlying values) ---
