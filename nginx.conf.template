worker_processes 1;
events { worker_connections 1024; }

http {
    server {
        listen ${PORT};

        # Socket.IO traffic (websocket + polling fallback) -> internal 4001.
        # netty-socketio's default context path is /socket.io/, which is
        # also the socket.io-client default, so no app-side path config
        # is needed for this to line up.
        location /socket.io/ {
            proxy_pass http://127.0.0.1:4001;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_read_timeout 60s;
        }

        # Everything else (REST API) -> internal 4000.
        location / {
            proxy_pass http://127.0.0.1:4000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }
}
